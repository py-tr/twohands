# Two Hands: every environment variable the app, worker, CLI, Evolus integration and deploy scripts read.
# cp .env.example .env   then fill in what you need. Names only, no values; .env is gitignored and never committed.
# With no .env at all the app still serves every measured result; nothing below is needed to browse or run `make eval`.
# Leave optional lines commented: an empty value is not the same as unset.

# --- AMD Token Factory (live reads, batch runs) ---
# API key from notebooks.amd.com/tokenfactory
AMD_KEY=
# OpenAI-compatible base URL from the Token Factory user manual
AMD_BASE_URL=
# TWOHANDS_LIVE_MODEL=                    # live reader: gemma (default; falls back to qwen when Gemma is not listed) or qwen
# TWOHANDS_MODEL_GEMMA=                   # override the Gemma model id sent to the endpoint
# TWOHANDS_MODEL_QWEN=                    # override the Qwen model id sent to the endpoint

# --- Self-hosted vLLM endpoint instead of the Token Factory (scripts/endpoint_switch.py, deploy/mi300x/) ---
# TWOHANDS_BASE_URL=                      # base URL of your own OpenAI-compatible vLLM server
# TWOHANDS_KEY=                           # its API key (= the server's VLLM_API_KEY)
# VLLM_API_KEY=                           # key the vLLM server is started with (deploy/mi300x/box.sh)
# HF_TOKEN=                               # Hugging Face token to download pinned weights (deploy/mi300x/box.sh)
# HF_DIR=                                 # where weights are stored on the GPU box (default /root/hf)

# --- Public deployment ---
# https://<domain> or http://<ip>; used for Evolus callbacks and the API page
TWOHANDS_PUBLIC_URL=
# TWOHANDS_MAIN_URL=                      # main-site URL the static mirror links to (app/export_static.py)
# TWOHANDS_GATE_TOKEN=                    # Bearer token for POST /api/gate (called by Evolus)
# SITE_ADDRESS=                           # Caddy site address; deploy/deploy.sh writes it (domain, or :80)
# REMOTE_DIR=                             # deploy/deploy.sh: install folder on the server (default /opt/twohands)
# ENV_FILE=                               # deploy/deploy.sh: which local .env to copy to the server
# DOMAIN=                                 # deploy/deploy.sh: domain for HTTPS (second argument)

# --- Spending and pacing guards (shared AMD key) ---
# TWOHANDS_KEY_DAILY_USD=                 # whole key's daily cap (default 1.00), split by role in twohands/budgets.py
# TWOHANDS_MAX_DAILY_USD=                 # batch runner's whole-key cap (default 0.80)
# TWOHANDS_BULK_DAILY_USD=                # daily share for bulk batch runs
# TWOHANDS_WORKER_DAILY_USD=              # daily share for the live-audit worker
# TWOHANDS_LIVE_RESERVE_USD=              # daily amount always kept for live reads
# TWOHANDS_RPM=                           # request starts per minute across all processes (default 16)
# TWOHANDS_LIVE_RPM=                      # of those, reserved for live reads (default 4)
# TWOHANDS_CONCURRENCY=                   # requests in flight per process
# TWOHANDS_WORKERS=                       # parallel workers of a batch run
# LIVE_MAX_READS_PER_DAY=                 # live-read button: reads per day
# LIVE_MAX_USD_PER_DAY=                   # live-read button: dollars per day
# LIVE_MIN_REMAINING_USD=                 # live-read button: stop when the key has less left than this
# LIVE_QUEUE_MAX=                         # live-read button: queue length
# LIVE_RETRIES=                           # live-read button: retries on a provider error

# --- State files (defaults under cache/ and app/state/) ---
# TWOHANDS_RATE_FILE=                     # shared rate-limiter file
# TWOHANDS_SPEND_FILE=                    # append-only spend ledger (default cache/spend.jsonl)
# TWOHANDS_HEALTH_FILE=                   # endpoint health log (default results/endpoint_health.jsonl)

# --- Live-audit worker (python -m twohands.worker) ---
# TWOHANDS_WORKER_DIR=                    # output folder (default live_audit/)
# TWOHANDS_WORKER_SEED=                   # folder to seed a fresh worker from
# TWOHANDS_WORKER_CONCURRENCY=            # reads in flight (default 3; WORKER_CONCURRENCY is an alias)
# TWOHANDS_WORKER_DISK_MB=                # disk cap for downloaded pages (default 2000)
# TWOHANDS_WORKER_PAGE_KB=                # stored page size target (default 150)
# TWOHANDS_WORKER_FETCH_INTERVAL_S=       # seconds between page downloads (minimum 1)
# TWOHANDS_WORKER_STALL_S=                # watchdog: restart after this many seconds without progress

# --- CLI and MCP server ---
# TWOHANDS_MCP_ROOTS=                     # extra folders the MCP server may read (os.pathsep list)
# TWOHANDS_OTS=                           # 0 turns off OpenTimestamps stamping of audit roots

# --- Audit-request emails (app/request.py; email is sent only when all four of HOST/USER/PASS/NOTIFY_TO are set) ---
# SMTP_HOST=                              # SMTP server
# SMTP_PORT=                              # SMTP port (optional)
# SMTP_USER=                              # SMTP user
# SMTP_PASS=                              # SMTP password
# NOTIFY_TO=                              # operator address that receives audit requests

# --- Evolus (python -m evolus setup writes the ids to evolus/ids.json; these override it) ---
# EVOLUS_KEY=                             # Evolus API key of the event workspace
# EVOLUS_USER_KEY=                        # personal User API key (needed to create the extractor and the library)
# EVOLUS_API=                             # Evolus API base URL
# EVOLUS_APP_ID=                          # workspace application id
# EVOLUS_WORKSPACE_URL=                   # link to the workspace shown in the app
# EVOLUS_AGENT=                           # main agent id ("Intake clerk")
# EVOLUS_EXTRACTOR_AGENT_ID=              # extractor agent id ("Tally sheet reader")
# EVOLUS_EXTRACTOR_ID=                    # document extractor id
# EVOLUS_LIBRARY_ID=                      # knowledge library id
# EVOLUS_WORKFLOW_ID=                     # workflow "Review hand-off"
# EVOLUS_FILING_WORKFLOW_ID=              # filing workflow
# EVOLUS_AUDIT_WORKFLOW_ID=               # workflow "Audit finding"
# EVOLUS_REVIEWER_EMAIL=                  # reviewer the human-review tasks are assigned to
# EVOLUS_CALLBACK_KEY=                    # shared secret Evolus sends on POST /api/evolus/callback
# EVOLUS_DAILY_RUNS=                      # cap on Evolus runs a day (default 60)
# EVOLUS_LIVE=                            # 0 stops the live-audit worker from opening Evolus cases
# EVOLUS_QUOTA_FILE=                      # file that counts the day's Evolus runs
